rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function hasUserProfile() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function myUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function isAdmin() {
      return hasUserProfile()
        && myUser().data.isAdmin == true;
    }

    function isActiveUser() {
      return hasUserProfile()
        && myUser().data.suspended != true;
    }

    function isPaidUser() {
      return isActiveUser()
        && myUser().data.plan == "paid";
    }


    // ============================================================
    // USERS
    // ============================================================

    match /users/{uid} {

      // ----------------------------------------------------------
      // NEW ACCOUNT
      // ----------------------------------------------------------
      //
      // A newly registered user is ALWAYS:
      //   plan      = free
      //   isAdmin   = false
      //   suspended = false
      //
      // This prevents a user from registering themselves as admin
      // or paid.
      // ----------------------------------------------------------

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'email',
          'name',
          'plan',
          'isAdmin',
          'suspended',
          'createdAt'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.plan == "free"
        && request.resource.data.isAdmin == false
        && request.resource.data.suspended == false;


      // ----------------------------------------------------------
      // READ
      // ----------------------------------------------------------
      //
      // User → own profile only
      // Admin → all user profiles
      // ----------------------------------------------------------

      allow read: if signedIn()
        && (
          request.auth.uid == uid
          || isAdmin()
        );


      // ----------------------------------------------------------
      // UPDATE
      // ----------------------------------------------------------
      //
      // ADMIN:
      //   Can change:
      //   - name
      //   - plan
      //   - suspended
      //   - other normal profile fields
      //
      //   CANNOT change isAdmin through the website.
      //
      // NORMAL USER:
      //   Can change ONLY their name.
      //
      // This prevents users from upgrading themselves,
      // unsuspending themselves, or becoming administrators.
      // ----------------------------------------------------------

      allow update: if signedIn()
        && (
          (
            isAdmin()
            && request.resource.data.isAdmin == resource.data.isAdmin
          )
          ||
          (
            request.auth.uid == uid
            && request.resource.data.email == resource.data.email
            && request.resource.data.plan == resource.data.plan
            && request.resource.data.isAdmin == resource.data.isAdmin
            && request.resource.data.suspended == resource.data.suspended
            && request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly(['name'])
          )
        );


      // ----------------------------------------------------------
      // DELETE
      // ----------------------------------------------------------
      //
      // Only admin can remove a Firestore profile.
      // ----------------------------------------------------------

      allow delete: if isAdmin()
        && uid != request.auth.uid;
    }


    // ============================================================
    // QUESTIONS
    // ============================================================

    match /questions/{questionId} {

      // ----------------------------------------------------------
      // READ
      // ----------------------------------------------------------
      //
      // Admin:
      //   Everything
      //
      // Free active user:
      //   Only tier = free
      //
      // Paid active user:
      //   tier = free OR paid
      //
      // IMPORTANT:
      // Firestore rules are NOT filters.
      // The website should query one tier at a time.
      // ----------------------------------------------------------

      allow read: if
        isAdmin()

        ||

        (
          isActiveUser()
          && resource.data.tier == "free"
        )

        ||

        (
          isPaidUser()
          && (
            resource.data.tier == "free"
            || resource.data.tier == "paid"
          )
        );


      // ----------------------------------------------------------
      // WRITE
      // ----------------------------------------------------------

      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // RESOURCES
    // PDF NOTES + MODEL PAPERS
    // ============================================================

    match /resources/{resourceId} {

      // Admin → all resources
      // Paid users → resources
      // Free users → denied
      allow read: if isAdmin()
        || isPaidUser();


      // Only admin can manage resources.
      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // PAYMENT REQUESTS
    // ============================================================

    match /paymentRequests/{requestId} {

      // ----------------------------------------------------------
      // STUDENT PAYMENT SUBMISSION
      // ----------------------------------------------------------
      //
      // Exact course price:
      // ₹749.50
      //
      // Initial status:
      // pending
      //
      // User can submit only for their own account.
      // ----------------------------------------------------------

      allow create: if isActiveUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.amount == 749.50
        && request.resource.data.status == "pending"
        && request.resource.data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'amount',
          'utr',
          'paymentDate',
          'status',
          'createdAt'
        ]);


      // ----------------------------------------------------------
      // READ
      // ----------------------------------------------------------
      //
      // Student → own payment requests
      // Admin → all payment requests
      // ----------------------------------------------------------

      allow read: if signedIn()
        && (
          resource.data.uid == request.auth.uid
          || isAdmin()
        );


      // ----------------------------------------------------------
      // PAYMENT VERIFICATION
      // ----------------------------------------------------------
      //
      // ONLY ADMIN can:
      //   verify
      //   reject
      //   edit
      //   delete
      // ----------------------------------------------------------

      allow update, delete: if isAdmin();
    }


    // ============================================================
    // ACTIVITY LOGS
    // ============================================================

    match /activities/{activityId} {

      // ----------------------------------------------------------
      // CREATE
      // ----------------------------------------------------------
      //
      // A logged-in user can create an activity record only
      // for their own UID.
      //
      // Admin activity can also be recorded.
      // ----------------------------------------------------------

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type is string
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'type',
          'name',
          'plan',
          'isAdmin',
          'tab',
          'score',
          'total',
          'resourceId',
          'title',
          'resourceType',
          'amount',
          'utrLast4',
          'paymentDate',
          'targetUid',
          'suspended',
          'requestId',
          'category',
          'tier',
          'questionId',
          'createdAt',
          'added'
        ]);


      // ----------------------------------------------------------
      // ADMIN-ONLY ACTIVITY HISTORY
      // ----------------------------------------------------------

      allow read, update, delete: if isAdmin();
    }


    // ============================================================
    // DEFAULT DENY
    // ============================================================
    //
    // Anything not explicitly allowed above is denied.
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
